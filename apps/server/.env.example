# --- HTTP ---
PORT=4000
# Comma-separated list of allowed browser origins (CORS + Socket.IO)
CORS_ORIGINS=http://localhost:3000
# Public URL of the web app; used to build invitation links
WEB_URL=http://localhost:3000

# --- Database (PostgreSQL via Prisma) ---
DATABASE_URL=postgresql://chess:chess@localhost:5432/chess?schema=public

# --- Redis (Socket.IO adapter + shared game coordination) ---
# Leave empty to run a single backend instance without Redis.
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN=7d
